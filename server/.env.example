# Database
MONGO_DB_URL=mongodb://localhost:27017/koperasi

# JWT
JWT_SECRET=your-super-secret-jwt-key

# Stripe (if using payment)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Server Configuration
PORT=8000

# IMPORTANT: Set these for production deployment
# For AWS deployment, set SERVER_URL to your actual domain
SERVER_URL=http://localhost:8000
CLIENT_URL=http://localhost:5173

# For production (AWS/Vercel/etc), example:
# SERVER_URL=https://your-api-domain.com
# CLIENT_URL=https://your-frontend-domain.com

# CORS Origins
CORS_ORIGIN1=http://localhost:5173
CORS_ORIGIN2=http://localhost:3000
CORS_ORIGIN3=https://your-production-domain.com